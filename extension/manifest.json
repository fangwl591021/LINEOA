{
  "manifest_version": 3,
  "name": "LINEOA 測試版",
  "version": "0.1.0",
  "description": "在 LINE Official Account Manager 顯示知識庫回覆建議；不會自動發送訊息。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://line-oa.fangwl591021.workers.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINEOA",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://manager.line.biz/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "LINEOA 測試版",
  "version": "0.1.4",
  "description": "在 LINE Official Account Manager 提供 ACTION 風格管理介面、聊天室監控與知識庫回覆建議。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://line-oa.fangwl591021.workers.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINEOA",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manager.line.biz/*",
        "https://chat.line.biz/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}